{
  "name": "@ObeoNetwork/react-trello",
  "version": "2.4.11",
  "description": "Pluggable components to add a trello like kanban board to your application",
  "main": "dist/react-trello.cjs.js",
  "module": "dist/react-trello.es.js",
  "files": [
    "dist",
    "README"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 9002",
    "test": "vitest --run --config vite.config.js",
    "test:watch": "vitest --config vite.config.js",
    "test:install-browser": "playwright install chromium",
    "coverage": "vitest run --config vite.config.js --coverage",
    "build": "vite build --config vite.config.js",
    "docs": "storybook build -o docs",
    "commit": "git cz",
    "format": "pretty-quick \"src/**/*.{js,jsx}\"",
    "size": "size-limit"
  },
  "repository": "@ObeoNetwork/react-trello",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "keywords": [
    "react",
    "trello",
    "board"
  ],
  "author": "RC, Prakash",
  "license": "MIT",
  "dependencies": {
    "autosize": "^4.0.2",
    "classnames": "^2.2.6",
    "immutability-helper": "^2.8.1",
    "lodash": "^4.17.11",
    "prop-types": "^15.7.2",
    "react-popopo": "^2.1.9",
    "react-redux": "^7.2.3",
    "redux": "^5.0.1",
    "redux-actions": "^2.6.1",
    "redux-logger": "^3.0.6",
    "trello-smooth-dnd": "1.0.0",
    "uuid": "^3.3.2"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "commitizen": "^3.1.1",
    "cz-conventional-changelog": "^2.1.0",
    "i18next": "^17.0.3",
    "jsdom": "26.1.0",
    "playwright": "1.55.0",
    "prettier": "2.8.8",
    "pretty-quick": "^1.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^10.11.0",
    "semantic-release": "^17.2.3",
    "size-limit": "^1.3.7",
    "storybook": "10.5.10",
    "styled-components": "4.0.3",
    "vite": "8.1.5",
    "vitest": "3.2.4"
  },
  "peerDependencies": {
    "lodash": ">= 4.17.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": ">= 7.2.3",
    "redux": "^5.0.1",
    "redux-actions": ">= 2.6.1",
    "redux-logger": ">= 3.0.6",
    "styled-components": ">= 4.0.3"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-conventional-changelog"
    }
  },
  "size-limit": [
    {
      "path": "dist/**/*.js",
      "limit": "800 ms"
    }
  ]
}
